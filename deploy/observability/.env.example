# Copy this file to .env before `docker compose up` -- .env is gitignored
# repo-wide (this repo never commits an .env, even a non-secret one, so the
# pattern stays uniform). These values are placeholders: local-only, bound to
# 127.0.0.1, never leave the machine. Rotate before reusing anywhere else.
ELASTIC_PASSWORD=Legion-Local-Elastic-Dev-Only-01
KIBANA_PASSWORD=Legion-Local-Kibana-Dev-Only-01
FILEBEAT_PASSWORD=Legion-Local-Filebeat-Dev-Only-01
GRAFANA_PASSWORD=Legion-Local-Grafana-Dev-Only-01
STACK_VERSION=9.5.4
